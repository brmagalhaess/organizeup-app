# Copie para .env (nunca versione o .env).

# --- Banco ---
# Web conecta como ou_app; worker como ou_worker. Ambos sujeitos à RLS.
DATABASE_URL=postgres://ou_app:dev-app-pass@localhost:54329/organizeup
# Só o worker (migrador) recebe a URL do dono/superusuário.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:54329/organizeup
# Admin (BYPASSRLS, auditado). Na web só o painel /admin usa: leitura numa conexão somente leitura, ações registradas em ops.admin_access. Não usar em rotas comuns.
ADMIN_DATABASE_URL=postgres://ou_admin:dev-admin-pass@localhost:54329/organizeup
# Máximo de conexões de cada pool admin da web, leitura e escrita (opcional; padrão 2).
ADMIN_DATABASE_POOL_MAX=2
# Senhas que o migrador define para os roles (obrigatórias no primeiro migrate).
OU_APP_DB_PASSWORD=dev-app-pass
OU_WORKER_DB_PASSWORD=dev-worker-pass
OU_ADMIN_DB_PASSWORD=dev-admin-pass

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=troque-por-32-bytes-aleatorios-em-base64
BETTER_AUTH_URL=http://localhost:3000

# --- Documentos (CPF, CNPJ, razão social) ---
# Chave do cofre de documentos, só na web: 32 bytes em base64. Gere com: openssl rand -base64 32
# Vazia: quem mora no Brasil não consegue se cadastrar, nada fica em texto puro e /admin avisa. Quem mora fora segue.
# Perder a chave perde os documentos, e trocar exige recifrar tudo: guarde fora do banco e das cópias de segurança.
DOCUMENT_ENCRYPTION_KEY=
# Quantos proxies nossos ficam na frente da web. O IP do limite de pedidos é contado da direita em x-forwarded-for,
# porque o cliente escreve o que quiser à esquerda. Padrão 1: o proxy do Dokploy.
TRUSTED_PROXY_HOPS=1

# --- E-mail transacional (Brevo) ---
# Chave da API v3 da Brevo. Sem ela nada é enviado e a web loga email_disabled.
BREVO_API_KEY=
# Remetente, já verificado na Brevo. Também aceita BREVO_SENDER_NAME e BREVO_SENDER_EMAIL.
# EMAIL_ENABLED=false desliga todo envio.
EMAIL_FROM_NAME=OrganizeUp
EMAIL_FROM_ADDRESS=notificacoes@organizeup.com.br
# Só e2e: grava os e-mails neste arquivo em vez de enviar. Ignorado com NODE_ENV=production.
EMAIL_CAPTURE_FILE=

# --- Painel do serviço (/admin) ---
# Ids da tabela `user` que podem abrir /admin, separados por vírgula (cada um copia o seu em Configurações).
ADMIN_USER_IDS=
# Só desenvolvimento e e2e: e-mails que podem abrir /admin. Nunca em produção (e-mail sem conta pode ser tomado).
ADMIN_EMAILS=
# Só e2e: liga admin.spec.ts; o servidor de teste sobe com ADMIN_EMAILS igual a este valor.
E2E_ADMIN_EMAIL=
# Só e2e, no Playwright: conexão do worker, para notificacoes.spec.ts rodar o agente de categorias de verdade.
# Também precisa de ADMIN_DATABASE_URL no mesmo banco.
E2E_WORKER_DATABASE_URL=

# --- Assistente com IA ---
# Chave da API da Anthropic, na web e no worker, nunca com NEXT_PUBLIC. Vazia: a tela diz que o assistente está indisponível e o resto segue igual.
ANTHROPIC_API_KEY=
# Identificador do workspace (wrkspc_...). Obrigatório só quando a chave não pertence a um workspace.
ANTHROPIC_WORKSPACE_ID=
# Teto de gasto do serviço no mês, em dólares. Ao bater, o assistente para sozinho até o mês seguinte.
AI_MONTHLY_BUDGET_USD=50
# Teto por família e por dia: entrada, saída e escrita de cache, sem contar leitura de cache.
AI_FAMILY_DAILY_TOKENS=200000
# Só e2e: endereço de apps/web/e2e/fake-model.mjs. Ignorado com NODE_ENV=production e fora de 127.0.0.1/localhost.
AI_TEST_BASE_URL=
# Só e2e, no Playwright: liga assistente.spec.ts.
E2E_ASSISTANT=

# --- Planos e assinatura (ADR-0023) ---
# Chave da API da Stripe, na web e no worker, nunca com NEXT_PUBLIC. Em teste, sk_test_ ou rk_test_. Vazia: a tela de planos diz que a assinatura ainda não está configurada.
STRIPE_SECRET_KEY=
# Segredo do endpoint /api/webhooks/stripe (whsec_...). Vazio: o webhook responde 503 e nada entra.
STRIPE_WEBHOOK_SECRET=
# Libera chave de produção (sk_live_, rk_live_). Só o fundador define, depois da seção 7 da especificação. Fora daqui, o código recusa operar com ela.
# STRIPE_ALLOW_LIVE=
# Só e2e, no Playwright: liga assinatura.spec.ts, que liga e desliga a chave billing_enabled. Também precisa de ADMIN_DATABASE_URL no mesmo banco. Rode sozinho, com --workers=1.
E2E_BILLING=

# --- Worker ---
# `false` desliga os agentes diários do produto (categorias, investimentos, dívidas, aposentadoria, viagens, metas,
# relatórios) e a coleta de cotações.
DAILY_AGENTS_ENABLED=true
# Chave da brapi.dev, só no worker. Opcional (ADR-0032): vazia, cotações vêm do Yahoo e rendimentos de FII da B3,
# de graça; com chave, a brapi é a primeira fonte e as gratuitas cobrem o que ela recusar.
BRAPI_TOKEN=
# Teto de chamadas à brapi por dia, somando todas as rodadas. Com 400, um mês fica abaixo das 15.000 do plano grátis.
BRAPI_MAX_CALLS_PER_DAY=400

# --- Ops API ---
# Lista separada por vírgula de SHA-256 (hex) dos tokens dos agentes.
# Gere com: node -e "const t=crypto.randomUUID()+crypto.randomUUID();console.log(t, require('crypto').createHash('sha256').update(t).digest('hex'))"
OPS_TOKEN_HASHES=

# --- Build ---
APP_COMMIT=dev
