{
  "name": "organizeup",
  "private": true,
  "description": "OrganizeUp — gestão financeira pessoal e aposentadoria, operada por agentes.",
  "type": "module",
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @organizeup/web dev",
    "dev:worker": "pnpm --filter @organizeup/worker dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm -r --workspace-concurrency=1 test:integration",
    "test:e2e": "pnpm --filter @organizeup/web test:e2e",
    "db:migrate": "pnpm --filter @organizeup/db migrate",
    "db:local": "pnpm --filter @organizeup/db local-pg",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
